{
  "name": "clinicq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Clinic appointment booking app and code-literacy course",
  "workspaces": [
    "apps/*",
    "docs"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:docs": "npm run dev --workspace docs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "docker:seed": "docker compose exec -e NODE_ENV=development api npm run db:seed",
    "docs:build": "npm run build --workspace docs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
