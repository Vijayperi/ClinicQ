# Copy this file to .env and adjust the values for your machine.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://clinicq:clinicq@localhost:5432/clinicq"

# Secret used to sign login tokens. Use a long random string (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string-of-at-least-32-chars"
JWT_EXPIRES_IN=1h

# The web app's address, allowed to call this API from the browser.
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
