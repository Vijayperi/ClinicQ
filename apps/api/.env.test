# Used by `npm test`. Points at a separate database so tests never touch dev data.
NODE_ENV=test
PORT=3001
DATABASE_URL="postgresql://clinicq:clinicq@localhost:5432/clinicq_test"
JWT_SECRET="test-secret-that-is-at-least-32-characters-long"
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=silent
